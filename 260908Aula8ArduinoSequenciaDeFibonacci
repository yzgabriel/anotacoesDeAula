unsigned long valorA = 0;
unsigned long valorB = 1;
unsigned long resultado = 0;

void setup()
{
}

void loop()
{
 Serial.begin(9600);
 resultado = valorA + valorB ;
 valorA = valorB;
 valorB = resultado;
 
 Serial.println(resultado);
  delay(20);
}